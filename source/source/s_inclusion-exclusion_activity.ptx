      </exercise>
      <exercise label="act_inclusion-exclusion_surjections-8-5_two-prop-2-5">
        <statement>
          <p>
            Terdapat <var width="10"/> fungsi yang sekaligus memenuhi <m>P_2</m> dan <m>P_5</m>.
          </p>
        </statement>
        <setup>
          <var>
            <condition number="6561">
              <feedback>
