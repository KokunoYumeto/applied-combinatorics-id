      <exercise label="act_inclusion-exclusion_surjections-formula_j-subsets">
        <statement>
          <p>
            Misalkan <m>S\subseteq [m]</m> dengan <m>|S| = j</m>. (Artinya, <m>S</m> adalah himpunan berunsur <m>j</m>.) Terdapat <var width="10"/> himpunan bagian dari <m>[m]</m> yang berukuran <m>j</m>.
          </p>
        </statement>
        <setup>
          <var>
            <condition string="C\(m,j\)">
              <feedback>
                <p>
                  Benar!
                </p>
              </feedback>
            </condition>
            <condition string=".*">
              <feedback>
                <p>
                  Belum tepat. Ingat kembali koefisien binomial dari Bab 2 dan gunakan notasi <m>C(n,k)</m>.
                </p>
              </feedback>
