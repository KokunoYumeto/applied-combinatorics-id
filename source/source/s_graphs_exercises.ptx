                        </row>
                      </tabular>
                      </description>
                      <prefigure xmlns="https://prefigure.org" label="planar-eulerian-n-10-m-21">
                        <diagram dimensions="(300,300)" margins="15">
                          <coordinates bbox="(-1,-1,1,1)">
                            <network scale="0.9" labels="yes" node-fill="#ddd" layout="planar" node-stroke="black">
                              <node at="0"  edges="[1,2,9]"/>
                              <node at="1"  edges="[2,3,9]"/>
                              <node at="2"  edges="[3,4]"/>
                              <node at="3"  edges="[4,5]"/>
                              <node at="4"  edges="[5,0]"/>
                              <node at="5"  edges="[6,7]"/>
                              <node at="6"  edges="[7,8,0]"/>
                              <node at="7"  edges="[8,9]"/>
