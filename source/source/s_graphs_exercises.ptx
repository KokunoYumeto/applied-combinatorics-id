                          </exercise>
                          <exercise>
                            <statement>
                            <p>Tentukan <m>\prufer(\bfT)</m> untuk pohon <m>\bfT</m> pada <xref ref="fig_graphs_tree-14verts-ex3"/>.</p>
                              <figure xml:id="fig_graphs_tree-14verts-ex3">
                              <caption>Pohon dengan <m>14</m> simpul</caption>
                                <image width="65%">
                                <description><p>Pohon berlabel dengan <m>14</m> simpul yang digunakan untuk menentukan kode Prüfer.</p>
                                  </description><latex-image>\begin{overpic}{external/tree-14verts-ex3}
                                    \put(50,32){\(1\)}
                                    \put(44,2){\(2\)}
                                    \put(2,34){\(3\)}
                                    \put(31,48){\(4\)}
                                    \put(62,56){\(5\)}
                                    \put(77,21){\(6\)}
                                    \put(17,51){\(7\)}
                                    \put(94,32){\(8\)}
                                    \put(34,20){\(9\)}
                                    \put(5,16){\(10\)}
                                    \put(74,2){\(11\)}
                                    \put(44,9){\(12\)}
