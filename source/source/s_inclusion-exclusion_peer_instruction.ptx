    </statement>
    <choices>
      <choice>
        <statement>
          <p><m>f</m></p>
        </statement>
      </choice>
      <choice correct="yes">
        <statement>
          <p><m>g</m></p>
        </statement>
      </choice>
      <choice correct="yes">
