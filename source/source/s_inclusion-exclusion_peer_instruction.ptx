<exercises xml:id="s_inclusion-exclusion_PI" component="runestone-PI">
  <title>Pertanyaan Instruksi Sejawat</title>
  <exercise label="inclusion-exclusion_PI_IE-sum-terms">
    <statement>
      <p>Misalkan <m>m=4</m>. Ada berapa suku dalam penjumlahan <md>\displaystyle
        \sum_{S\subseteq [m]} (-1)^{|S|}N(S)</md>?</p>
    </statement>
    <choices>
      <choice>
        <statement>
          <p>
            <m>2^{4-1} = 8 </m>
          </p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p>
            <m>2^{4}-1 = 15 </m>
          </p>
        </statement>
      </choice>
      <choice correct="yes">
        <statement>
          <p>
            <m>2^{4} = 16 </m>
          </p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p>
            <m>(4-1)! = 6 </m>
          </p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p>
            <m>4! = 24 </m>
          </p>
        </statement>
      </choice>
    </choices>
  </exercise>
  <exercise label="inclusion-exclusion_PI_surjection">
    <statement>
      <p>Manakah di antara fungsi-fungsi berikut dari <m>[6]</m> ke <m>[4]</m> yang
        merupakan fungsi surjektif?
        <md>
          \begin{array}{c|cccccc}
          x \amp 1 \amp 2 \amp 3 \amp 4 \amp 5 \amp 6\\\hline
          f(x) \amp 3 \amp 3 \amp 3 \amp 2 \amp 4 \amp 2\\
          g(x) \amp 1 \amp 3 \amp 3 \amp 2 \amp 4 \amp 2\\
          h(x) \amp 1 \amp 2 \amp 3 \amp 1 \amp 2 \amp 4
          \end{array}
        </md>
      </p>

        <!-- TODO Restore this after getting Runestone to do a better job rendering tables -->
