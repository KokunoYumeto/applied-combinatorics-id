<exercises xml:id="s_graphs_PI" component="runestone-PI">
  <title>Pertanyaan Pengajaran Sebaya</title>
  <exercise label="graphs_PI_subgraph1">
    <statement>
      <p>Pilih jawaban terbaik.
      </p>
      <image source="spanning_subgraph" width="85%">
        <description>Dua graf berlabel G dan H pada himpunan simpul 1 sampai 10; graf H mempertahankan seluruh simpul dan sebagian sisi graf G.</description>
      </image>
    </statement>
    <choices>
      <choice>
        <statement>
          <p><m>\bfH</m> merupakan subgraf dari <m>\bfG</m></p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p><m>\bfH</m> merupakan subgraf terinduksi dari <m>\bfG</m></p>
        </statement>
      </choice>
      <choice correct="yes">
        <statement>
          <p><m>\bfH</m> merupakan subgraf merentang dari <m>\bfG</m></p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p>Tidak satu pun jawaban di atas</p>
        </statement>
      </choice>
    </choices>
  </exercise>
  <exercise label="graphs_PI_subgraph2">
    <statement>
      <p>Pilih jawaban terbaik.
      </p>
      <image source="non_subgraph" width="85%">
        <description>Dua graf berlabel G dan H pada sepuluh simpul bernomor; diagram H memuat susunan sisi yang harus dibandingkan dengan sisi-sisi G.</description>
      </image>
    </statement>
    <choices>
      <choice>
        <statement>
          <p><m>\bfH</m> merupakan subgraf dari <m>\bfG</m></p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p><m>\bfH</m> merupakan subgraf terinduksi dari <m>\bfG</m></p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p><m>\bfH</m> merupakan subgraf merentang dari <m>\bfG</m></p>
        </statement>
      </choice>
      <choice correct="yes">
        <statement>
          <p>Tidak satu pun jawaban di atas</p>
        </statement>
      </choice>
    </choices>
  </exercise>  
  <exercise label="graphs_PI_subgraph3">
    <statement>
      <p>Pilih jawaban terbaik.
      </p>
      <image source="induced_subgraph" width="85%">
        <description>Graf G pada sepuluh simpul bernomor dan graf H pada simpul 2, 3, 5, 6, 8, dan 10, beserta semua sisi G di antara keenam simpul tersebut.</description>
      </image>
    </statement>
    <choices>
      <choice>
        <statement>
          <p><m>\bfH</m> merupakan subgraf dari <m>\bfG</m></p>
        </statement>
      </choice>
      <choice correct="yes">
        <statement>
          <p><m>\bfH</m> merupakan subgraf terinduksi dari <m>\bfG</m></p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p><m>\bfH</m> merupakan subgraf merentang dari <m>\bfG</m></p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p>Tidak satu pun jawaban di atas</p>
        </statement>
      </choice>
    </choices>
  </exercise>    
  <exercise label="graphs_PI_isomorphic1">
    <statement>
      <p>
        Graf <m>\bfG</m> dan <m>\bfH</m> isomorfik.
      </p>
      <image source="isomorphic_graphs-PI" width="85%">
        <description>Dua graf berlabel, G pada simpul a sampai f dan H pada simpul 1 sampai 6, dengan pola ketetanggaan yang sama dalam tata letak berbeda.</description>
      </image>
    </statement>
    <choices>
      <choice correct="yes">
        <statement>
          <p>Benar, keyakinan tinggi</p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p>Benar, keyakinan rendah</p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p>Salah, keyakinan rendah</p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p>Salah, keyakinan tinggi</p>
        </statement>
      </choice>
    </choices>
  </exercise>
  <exercise label="graphs_PI_isomorphic2">
    <statement>
      <p>
        Graf <m>\bfG</m> dan <m>\bfH</m> isomorfik.
      </p>
      <image source="nonisomorphic_graphs-PI" width="85%">
        <description>Dua graf berlabel, G pada simpul a sampai f dan H pada simpul 1 sampai 6; keduanya memiliki enam simpul tetapi pola derajatnya berbeda.</description>
      </image>
    </statement>
    <choices>
      <choice>
        <statement>
          <p>Benar, keyakinan tinggi</p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p>Benar, keyakinan rendah</p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p>Salah, keyakinan rendah</p>
        </statement>
      </choice>
      <choice correct="yes">
        <statement>
          <p>Salah, keyakinan tinggi</p>
        </statement>
      </choice>
    </choices>
  </exercise>
  <exercise label="graphs_PI_hamiltonian-G1">
    <statement>
      <p>Graf <m>\bfG_1</m> merupakan graf Hamilton.</p>
      <image width="40%">
      <description>
        <p>
          Graf dengan 10 simpul. Tetangga setiap simpul diberikan pada tabel berikut.
        </p>
        <tabular>
          <row>
            <cell>Simpul</cell>
            <cell>Tetangga</cell>
          </row>
          <row>
            <cell><m>1</m></cell>
            <cell><m>4</m>, <m>5</m></cell>
          </row>
          <row>
            <cell><m>2</m></cell>
            <cell><m>3</m>, <m>6</m>, <m>9</m></cell>
          </row>
          <row>
            <cell><m>3</m></cell>
            <cell><m>2</m>, <m>7</m>, <m>10</m></cell>
          </row>
          <row>
            <cell><m>4</m></cell>
            <cell><m>1</m>, <m>7</m>, <m>8</m>, <m>10</m></cell>
          </row>
          <row>
            <cell><m>5</m></cell>
            <cell><m>1</m>, <m>6</m>, <m>7</m></cell>
          </row>
          <row>
            <cell><m>6</m></cell>
            <cell><m>2</m>, <m>5</m>, <m>8</m></cell>
          </row>
          <row>
            <cell><m>7</m></cell>
            <cell><m>3</m>, <m>4</m>, <m>5</m></cell>
          </row>
          <row>
            <cell><m>8</m></cell>
            <cell><m>4</m>, <m>6</m>, <m>9</m></cell>
          </row>
          <row>
            <cell><m>9</m></cell>
            <cell><m>2</m>, <m>8</m>, <m>10</m></cell>
          </row>
          <row>
            <cell><m>10</m></cell>
            <cell><m>3</m>, <m>4</m>, <m>9</m></cell>
          </row>
        </tabular>
      </description>
      <prefigure xmlns="https://prefigure.org" label="img-hamgraph1">
        <diagram dimensions="(200,300)" margins="5">
          <definition>graph={1:[4,5],2:[3,6,9],3:[7,10],4:[7,8,10],5:[6,7],6:[8],8:[9],9:[10]}</definition>
          <coordinates bbox="(-1,-1,1,1)">
            <network graph="graph" scale="0.8" node-fill="#fcf" node-stroke="black" seed="1" labels="yes">
            </network>
          </coordinates>
        </diagram>
      </prefigure>
    </image>
    </statement>
    <choices>
      <choice correct="yes">
        <statement>
          <p>Benar, keyakinan tinggi</p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p>Benar, keyakinan rendah</p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p>Belum dapat menentukan</p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p>Salah, keyakinan rendah</p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p>Salah, keyakinan tinggi</p>
        </statement>
      </choice>
    </choices>
  </exercise>
