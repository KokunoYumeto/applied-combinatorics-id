      <choice>
        <statement>
          <p>Belum dapat menentukan</p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p>Salah, keyakinan rendah</p>
        </statement>
      </choice>
      <choice correct="yes">
        <statement>
          <p>Salah, keyakinan tinggi</p>
        </statement>
      </choice>
    </choices>
  </exercise>
